#!/usr/bin/env bash
# Pre-commit hook: byte-identical with CI for commits that can affect Rust.
# Refuses the commit if fmt or clippy are not clean.
# Scope matches CI: workspace default features (not --all-features).
# Commits whose staged paths CI would not send to the Rust jobs (see
# scripts/ci-scope.cjs) skip both checks. Without node, or on any
# classification error, the checks run.
#
# Versioned copy. To activate locally (works from the main checkout and
# from linked worktrees):
#   scripts/install-hooks.sh

set -euo pipefail

scope="$(node "$(git rev-parse --show-toplevel)/scripts/ci-scope.cjs" --hook 2>/dev/null)" || scope=rust
if [[ "$scope" == skip ]]; then
    echo "pre-commit: no staged path affects Rust; skipping fmt and clippy"
    exit 0
fi

echo "pre-commit: cargo fmt --check..."
cargo fmt --check || {
    echo ""
    echo "ERROR: cargo fmt --check failed."
    echo "Run 'cargo fmt' to fix, then retry commit."
    exit 1
}

echo "pre-commit: cargo clippy --workspace -- -D warnings..."
cargo clippy --workspace -- -D warnings || {
    echo ""
    echo "ERROR: cargo clippy --workspace -- -D warnings failed."
    echo "Fix warnings or add a justified #[allow(...)] with a comment."
    exit 1
}

echo "pre-commit: OK"
